        "total_keywords": {
          "default": 0,
          "minimum": 0,
          "title": "Total Keywords",
          "type": "integer"
        },
        "negatives": {
          "items": {
            "$ref": "#/$defs/NegativeKeyword"
          },
          "title": "Negatives",
          "type": "array"
        },
        "mapping": {
          "items": {
            "$ref": "#/$defs/KeywordPageMapping"
          },
