        },
        "jobs_to_be_done": {
          "items": {
            "type": "string"
          },
          "title": "Jobs To Be Done",
          "type": "array"
        },
        "share_of_revenue_pct": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
