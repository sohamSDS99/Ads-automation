    },
    "demand_map": {
      "$ref": "#/$defs/DemandMap"
    },
    "readiness": {
      "$ref": "#/$defs/Readiness"
    },
    "priced_keyword_list": {
      "items": {
        "$ref": "#/$defs/PricedKeyword"
      },
