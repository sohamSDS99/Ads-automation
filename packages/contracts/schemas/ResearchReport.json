            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "overlap_score": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Overlap Score"
        },
        "overlap_basis": {
          "items": {
            "type": "string"
          },
          "title": "Overlap Basis",
          "type": "array"
        }
      },
      "required": [
        "domain"
      ],
      "title": "Competitor",
      "type": "object"
    },
    "CompetitorAd": {
      "additionalProperties": true,
      "description": "1.3.2 `creative_corpus` \u2014 one observed ad.\n\n`screenshot_path` is a **storage key**, never a filesystem path (PRD \u00a75.2);\nthe PDF renderer resolves it through `storage.backend`.",
