      "type": "string"
    },
    "launch_readiness": {
      "enum": [
        "go",
        "go_with_fixes",
        "no_go"
      ],
      "title": "Launch Readiness",
      "type": "string"
    },
    "launch_blockers": {
      "items": {
        "$ref": "#/$defs/Claim"
      },
      "title": "Launch Blockers",
      "type": "array"
    },
    "business_context": {
