        },
        "screenshot_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Screenshot Path"
        }
      },
      "required": [
        "advertiser"
      ],
      "title": "CompetitorAd",
      "type": "object"
    },
    "ComplianceGuardrails": {
      "additionalProperties": true,
