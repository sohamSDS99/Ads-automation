        "winners": {
          "items": {
            "$ref": "#/$defs/PerformanceFinding"
          },
          "title": "Winners",
          "type": "array"
        },
        "losers": {
          "items": {
            "$ref": "#/$defs/PerformanceFinding"
          },
          "title": "Losers",
          "type": "array"
        },
        "structural_findings": {
          "items": {
            "type": "string"
          },
          "title": "Structural Findings",
          "type": "array"
        },
        "profitable_terms": {
          "items": {
            "$ref": "#/$defs/ProfitableTerm"
          },
          "title": "Profitable Terms",
          "type": "array"
        },
        "wasteful_terms": {
          "items": {
            "$ref": "#/$defs/WastefulTerm"
          },
          "title": "Wasteful Terms",
          "type": "array"
        },
        "tried_and_failed": {
          "items": {
            "$ref": "#/$defs/FailedExperiment"
          },
          "title": "Tried And Failed",
          "type": "array"
        }
      },
      "title": "AccountLearnings",
      "type": "object"
    },
    "AudienceList": {
      "additionalProperties": true,
      "description": "1.5.3 \u26f3 `audience_consent_check` \u2014 gated on an `approver` (data officer).",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "size": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Size"
        },
        "consent_basis": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Consent Basis"
        },
        "markets_allowed": {
          "items": {
            "type": "string"
          },
          "title": "Markets Allowed",
          "type": "array"
        },
        "usable": {
          "default": false,
          "title": "Usable",
          "type": "boolean"
        },
        "blocker": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Blocker"
        }
      },
      "required": [
        "name"
      ],
      "title": "AudienceList",
      "type": "object"
    },
    "BusinessContext": {
      "additionalProperties": true,
      "description": "Stage 1.1 rolled up.",
      "properties": {
        "products": {
          "items": {
            "$ref": "#/$defs/Product"
          },
          "title": "Products",
          "type": "array"
        },
        "ltv_estimate": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ltv Estimate"
        },
        "target_cac": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Cac"
        },
        "payback_months": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Payback Months"
        },
        "segments": {
          "items": {
            "$ref": "#/$defs/IcpSegment"
          },
          "title": "Segments",
          "type": "array"
        },
        "exclusions": {
          "items": {
            "$ref": "#/$defs/IcpExclusion"
          },
          "title": "Exclusions",
          "type": "array"
        },
        "markets": {
          "items": {
            "$ref": "#/$defs/MarketCoverage"
          },
          "title": "Markets",
          "type": "array"
        },
        "compliance": {
          "anyOf": [
            {
              "$ref": "#/$defs/ComplianceGuardrails"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "BusinessContext",
      "type": "object"
    },
    "Claim": {
      "additionalProperties": true,
      "description": "An assertion the report is prepared to stand behind.\n\nPRD \u00a711. `evidence_ids` has `min_length=1` because the alternative \u2014 an\noptional citation list \u2014 makes \"uncited\" the path of least resistance for\nboth the model and every future caller.",
      "properties": {
        "statement": {
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ],
          "title": "Confidence",
          "type": "string"
        }
      },
      "required": [
        "statement",
        "evidence_ids",
        "confidence"
      ],
      "title": "Claim",
      "type": "object"
    },
    "CompetitiveLandscape": {
      "additionalProperties": true,
      "description": "Stage 1.3 rolled up.",
      "properties": {
        "competitors": {
          "items": {
            "$ref": "#/$defs/Competitor"
          },
          "title": "Competitors",
          "type": "array"
        },
        "ads": {
          "items": {
            "$ref": "#/$defs/CompetitorAd"
          },
          "title": "Ads",
          "type": "array"
        },
        "message_clusters": {
          "items": {
            "$ref": "#/$defs/MessageCluster"
          },
          "title": "Message Clusters",
          "type": "array"
        },
        "spend_estimates": {
          "items": {
            "$ref": "#/$defs/SpendEstimate"
          },
          "title": "Spend Estimates",
          "type": "array"
        },
        "whitespace": {
          "items": {
            "$ref": "#/$defs/Whitespace"
          },
          "title": "Whitespace",
          "type": "array"
        },
        "recommended_claim": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Recommended Claim"
        },
        "substantiation_required": {
          "items": {
            "type": "string"
          },
          "title": "Substantiation Required",
          "type": "array"
        }
      },
      "title": "CompetitiveLandscape",
      "type": "object"
    },
    "Competitor": {
      "additionalProperties": true,
      "description": "1.3.1 `competitor_set`.",
      "properties": {
        "domain": {
          "title": "Domain",
          "type": "string"
