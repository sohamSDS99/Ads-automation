        "content_gaps": {
          "items": {
            "$ref": "#/$defs/ContentGap"
          },
          "title": "Content Gaps",
          "type": "array"
        }
      },
      "title": "DemandMap",
      "type": "object"
    },
    "FailedExperiment": {
      "additionalProperties": true,
