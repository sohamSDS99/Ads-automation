{
  "description": "One person-task, named enough for a badge and a row and no more.\n\nThe person-task *card* is S3-P8's, and this is deliberately not a step\ntoward it: no instructions, no artifact checklist, no attachments. What the\nrail and the landing's attention block need is who owes what and what it\nstops, and a shape that answers only that cannot quietly become the card.",
  "properties": {
    "task_id": {
      "format": "uuid",
      "title": "Task Id",
      "type": "string"
    },
    "task_key": {
      "title": "Task Key",
      "type": "string"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "status": {
      "title": "Status",
      "type": "string"
    },
    "blocking_for": {
      "title": "Blocking For",
      "type": "string"
    },
    "assignee_id": {
      "format": "uuid",
      "title": "Assignee Id",
      "type": "string"
    },
    "assignee_name": {
      "default": "",
      "title": "Assignee Name",
      "type": "string"
    },
    "mine": {
      "default": false,
      "title": "Mine",
      "type": "boolean"
    },
    "due_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Due At"
    }
  },
  "required": [
    "task_id",
    "task_key",
    "title",
    "status",
    "blocking_for",
    "assignee_id"
  ],
  "title": "OpenTaskRef",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
