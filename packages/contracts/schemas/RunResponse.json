{
  "$defs": {
    "DagEdge": {
      "description": "`source` must succeed before `target` may start.",
      "properties": {
        "source": {
          "title": "Source",
          "type": "string"
        },
        "target": {
          "title": "Target",
          "type": "string"
        }
      },
      "required": [
        "source",
        "target"
      ],
      "title": "DagEdge",
      "type": "object"
    },
    "DegradedSource": {
      "description": "One source that did not fully answer during this run (PRD \u00a715 NF4).\n\nThe console renders these as a banner and the report repeats them, so\n`detail` carries the connector's own words \u2014 for the Transparency Center\nthat is the name of the selector that stopped matching, which is the whole\npoint of PRD \u00a716's first row.",
      "properties": {
        "kind": {
          "description": "The kind of evidence that came back thin, e.g. `creative`.",
          "title": "Kind",
          "type": "string"
        },
        "nodes": {
          "description": "Which nodes hit it. Sorted, for a stable banner.",
          "items": {
            "type": "string"
          },
          "title": "Nodes",
          "type": "array"
        },
        "detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "What the connector said went wrong. Shown verbatim.",
          "title": "Detail"
        },
        "severity": {
          "default": "degraded",
          "description": "`degraded` \u2014 a connector malfunctioned mid-run and the report is thinner for it. `unavailable` \u2014 nothing of this kind is connected, which is a setup state and not a fault.",
          "enum": [
            "degraded",
            "unavailable"
          ],
          "title": "Severity",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "DegradedSource",
      "type": "object"
    },
    "NodeRunStatus": {
      "description": "Per-node lifecycle.\n\nPRD \u00a76 leaves `NodeRun.status` untyped; these values are the ones \u00a77.2\nexecution semantics and the \u00a713.2 status palette actually require.",
      "enum": [
        "queued",
        "running",
        "awaiting_approval",
        "succeeded",
        "failed",
        "skipped"
      ],
      "title": "NodeRunStatus",
      "type": "string"
    },
    "NodeState": {
      "description": "One node of the DAG, with whatever this run has done to it so far.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "stage": {
          "title": "Stage",
          "type": "string"
        },
        "task_class": {
          "$ref": "#/$defs/TaskClass"
        },
        "depends_on": {
          "items": {
            "type": "string"
          },
          "title": "Depends On",
          "type": "array"
        },
        "gate": {
          "title": "Gate",
          "type": "boolean"
        },
        "status": {
          "anyOf": [
            {
              "$ref": "#/$defs/NodeRunStatus"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Null until the run reaches this node."
        },
        "attempt": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attempt"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "token_in": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Token In"
        },
        "token_out": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Token Out"
        },
        "cost_usd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost Usd"
        },
        "latency_ms": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latency Ms"
        },
        "started_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Started At"
        },
        "finished_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finished At"
        },
        "error": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        }
      },
      "required": [
        "id",
        "name",
        "stage",
        "task_class",
        "depends_on",
        "gate"
      ],
      "title": "NodeState",
      "type": "object"
    },
    "RunMode": {
      "enum": [
        "full",
        "partial"
      ],
      "title": "RunMode",
      "type": "string"
    },
    "RunStage": {
      "description": "Which pipeline a run executes (Stage 02 PRD \u00a77.1).\n\nOne `run` table, two DAGs. A plan run consumes exactly one research run and\nsays so in `source_run_id`; the `CHECK` in migration 0013 makes the two\nfacts inseparable, so \"a plan run\" and \"a run with a source\" are the same\nstatement rather than two that can drift apart.",
      "enum": [
        "research",
        "plan"
      ],
      "title": "RunStage",
      "type": "string"
    },
    "RunStatus": {
      "enum": [
        "queued",
        "running",
        "awaiting_approval",
        "succeeded",
        "failed",
        "cancelled"
      ],
      "title": "RunStatus",
      "type": "string"
    },
    "RunTrigger": {
      "enum": [
        "manual",
        "schedule"
      ],
      "title": "RunTrigger",
      "type": "string"
    },
    "TaskClass": {
      "description": "What a node asks of a model. The only thing a node declares.",
      "enum": [
        "extract",
        "classify",
        "synthesize",
        "critique"
      ],
      "title": "TaskClass",
      "type": "string"
    }
  },
  "description": "`GET /runs/{id}` \u2014 the full state of a run, including its DAG.",
  "properties": {
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "project_id": {
      "format": "uuid",
      "title": "Project Id",
      "type": "string"
    },
    "stage": {
      "$ref": "#/$defs/RunStage",
      "default": "research",
      "description": "Which DAG this run executes. The console reads it to refuse a run opened under the wrong stage's route, so a research id pasted into the plan console says so instead of rendering a plan-shaped shell around research nodes."
    },
    "status": {
      "$ref": "#/$defs/RunStatus"
    },
    "mode": {
      "$ref": "#/$defs/RunMode"
    },
    "trigger": {
      "$ref": "#/$defs/RunTrigger"
    },
    "triggered_by": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Triggered By"
    },
    "triggered_by_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Display name behind `triggered_by`. Null for a scheduled run, which has no actor, and for a person since removed from the workspace.",
      "title": "Triggered By Name"
    },
    "parent_run_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "The run this one follows \u2014 the newest succeeded run of the same project at the moment this one launched. Null for a project's first run. The Report Viewer's compare toggle is offered only when this is set.",
      "title": "Parent Run Id"
    },
    "selected_node_ids": {
      "items": {
        "type": "string"
      },
      "title": "Selected Node Ids",
      "type": "array"
    },
    "cost_usd": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Cost Usd"
    },
    "token_in": {
      "title": "Token In",
      "type": "integer"
    },
    "token_out": {
      "title": "Token Out",
      "type": "integer"
    },
    "started_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Started At"
    },
    "finished_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Finished At"
    },
    "error": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "title": "Error"
    },
    "nodes": {
      "items": {
        "$ref": "#/$defs/NodeState"
      },
      "title": "Nodes",
      "type": "array"
    },
    "edges": {
      "items": {
        "$ref": "#/$defs/DagEdge"
      },
      "title": "Edges",
      "type": "array"
    },
    "degraded_sources": {
      "description": "Sources that did not fully answer. Derived from the nodes' own `coverage` output, so it is durable and survives a page reload \u2014 the SSE stream is not the only place this appears.",
      "items": {
        "$ref": "#/$defs/DegradedSource"
      },
      "title": "Degraded Sources",
      "type": "array"
    }
  },
  "required": [
    "id",
    "project_id",
    "status",
    "mode",
    "trigger",
    "triggered_by",
    "selected_node_ids",
    "cost_usd",
    "token_in",
    "token_out",
    "started_at",
    "finished_at",
    "error",
    "nodes",
    "edges"
  ],
  "title": "RunResponse",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
