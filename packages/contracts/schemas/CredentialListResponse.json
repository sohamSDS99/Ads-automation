{
  "$defs": {
    "CredentialFieldInfo": {
      "description": "One input the browser should render for this kind.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        },
        "secret": {
          "description": "Render as a password field and never echo it back",
          "title": "Secret",
          "type": "boolean"
        },
        "hint": {
          "default": "",
          "title": "Hint",
          "type": "string"
        }
      },
      "required": [
        "name",
        "label",
        "required",
        "secret"
      ],
      "title": "CredentialFieldInfo",
      "type": "object"
    },
    "CredentialKind": {
      "enum": [
        "openrouter",
        "google_ads",
        "dataforseo",
        "brightdata",
        "smtp"
      ],
      "title": "CredentialKind",
      "type": "string"
    },
    "CredentialKindInfo": {
      "description": "A kind the interface can offer, and the shape of its form.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/CredentialKind"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "where": {
          "description": "Which screen configures it: `settings` or `sources`",
          "title": "Where",
          "type": "string"
        },
        "fields": {
          "items": {
            "$ref": "#/$defs/CredentialFieldInfo"
          },
          "title": "Fields",
          "type": "array"
        },
        "oauth_provider": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "When set, offer a Connect button for this provider instead of a form",
          "title": "Oauth Provider"
        },
        "oauth_ready": {
          "default": false,
          "description": "Whether this deployment can actually run that consent \u2014 i.e. whether it has an OAuth client configured. False means the paste-everything fallback is the only way to connect, and is the only case where it is offered.",
          "title": "Oauth Ready",
          "type": "boolean"
        },
        "oauth_fields": {
          "description": "Fields the consent flow supplies, so the form does not ask for them",
          "items": {
            "type": "string"
          },
          "title": "Oauth Fields",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "label",
        "description",
        "where",
        "fields"
      ],
      "title": "CredentialKindInfo",
      "type": "object"
    },
    "CredentialScope": {
      "enum": [
        "workspace",
        "project",
        "user"
      ],
      "title": "CredentialScope",
      "type": "string"
    },
    "CredentialSummary": {
      "description": "A stored credential, as the vault is allowed to describe it.\n\n`meta` holds only what was marked non-secret when the credential was\nwritten \u2014 an account id, a login, the last four characters of a key.",
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/CredentialKind"
        },
        "scope": {
          "$ref": "#/$defs/CredentialScope"
        },
        "project_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Project Id"
        },
        "user_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "User Id"
        },
        "meta": {
          "additionalProperties": true,
          "title": "Meta",
          "type": "object"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "format": "uuid",
          "title": "Created By",
          "type": "string"
        },
        "created_by_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Created By Name"
        },
        "last_tested_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Tested At"
        },
        "last_test_ok": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Test Ok"
        }
      },
      "required": [
        "id",
        "kind",
        "scope",
        "meta",
        "created_at",
        "created_by"
      ],
      "title": "CredentialSummary",
      "type": "object"
    }
  },
  "properties": {
    "credentials": {
      "items": {
        "$ref": "#/$defs/CredentialSummary"
      },
      "title": "Credentials",
      "type": "array"
    },
    "kinds": {
      "items": {
        "$ref": "#/$defs/CredentialKindInfo"
      },
      "title": "Kinds",
      "type": "array"
    }
  },
  "required": [
    "credentials",
    "kinds"
  ],
  "title": "CredentialListResponse",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
