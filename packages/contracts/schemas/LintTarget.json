{
  "additionalProperties": false,
  "description": "One piece of copy or one image, with everything a rule needs to scope it.\n\n`ref` is the caller's identifier and is echoed back on every finding. The\nlinter never dereferences it, so Stage 04 can use whatever it likes \u2014\nan asset id, a row number, a draft slug.",
  "properties": {
    "ref": {
      "minLength": 1,
      "title": "Ref",
      "type": "string"
    },
    "surface": {
      "enum": [
        "rsa_headline",
        "rsa_description",
        "rsa_path",
        "long_headline",
        "pmax_headline",
        "pmax_description",
        "asset_group_description",
        "display_text",
        "youtube_script",
        "sitelink",
        "callout",
        "structured_snippet",
        "business_name",
        "landing_page_section",
        "search_image",
        "pmax_image",
        "display_image",
        "demand_gen_image"
      ],
      "title": "Surface",
      "type": "string"
    },
    "campaign_type": {
      "minLength": 1,
      "title": "Campaign Type",
      "type": "string"
    },
    "market": {
      "minLength": 1,
      "title": "Market",
      "type": "string"
    },
    "language": {
      "minLength": 1,
      "title": "Language",
      "type": "string"
    },
    "text": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Text"
    },
    "image_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Image Ref"
    },
    "generated_by_ai": {
      "default": false,
      "title": "Generated By Ai",
      "type": "boolean"
    },
    "image_metrics": {
      "anyOf": [
        {
          "additionalProperties": {
            "type": "number"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Image Metrics"
    }
  },
  "required": [
    "ref",
    "surface",
    "campaign_type",
    "market",
    "language"
  ],
  "title": "LintTarget",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
