{
  "$defs": {
    "CredentialFieldInfo": {
      "description": "One input the browser should render for this kind.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        },
        "secret": {
          "description": "Render as a password field and never echo it back",
          "title": "Secret",
          "type": "boolean"
        },
        "hint": {
          "default": "",
          "title": "Hint",
          "type": "string"
        }
      },
      "required": [
        "name",
        "label",
        "required",
        "secret"
      ],
      "title": "CredentialFieldInfo",
      "type": "object"
    },
    "CredentialKind": {
      "enum": [
        "openrouter",
        "google_ads",
        "dataforseo",
        "smtp"
      ],
      "title": "CredentialKind",
      "type": "string"
    }
  },
  "description": "A kind the interface can offer, and the shape of its form.",
  "properties": {
    "kind": {
      "$ref": "#/$defs/CredentialKind"
    },
    "label": {
      "title": "Label",
      "type": "string"
    },
    "description": {
      "title": "Description",
      "type": "string"
    },
    "where": {
      "description": "Which screen configures it: `settings` or `sources`",
      "title": "Where",
      "type": "string"
    },
    "fields": {
      "items": {
        "$ref": "#/$defs/CredentialFieldInfo"
      },
      "title": "Fields",
      "type": "array"
    }
  },
  "required": [
    "kind",
    "label",
    "description",
    "where",
    "fields"
  ],
  "title": "CredentialKindInfo",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
