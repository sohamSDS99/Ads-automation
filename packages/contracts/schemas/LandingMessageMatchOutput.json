{
  "$defs": {
    "DeviceFlag": {
      "additionalProperties": false,
      "properties": {
        "mobile": {
          "default": false,
          "title": "Mobile",
          "type": "boolean"
        },
        "desktop": {
          "default": false,
          "title": "Desktop",
          "type": "boolean"
        }
      },
      "title": "DeviceFlag",
      "type": "object"
    },
    "DevicePx": {
      "additionalProperties": false,
      "properties": {
        "mobile": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mobile"
        },
        "desktop": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Desktop"
        }
      },
      "title": "DevicePx",
      "type": "object"
    },
    "DeviceText": {
      "additionalProperties": false,
      "properties": {
        "mobile": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mobile"
        },
        "desktop": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Desktop"
        }
      },
      "title": "DeviceText",
      "type": "object"
    },
    "LandingPageMatch": {
      "additionalProperties": false,
      "properties": {
        "audit_id": {
          "format": "uuid",
          "title": "Audit Id",
          "type": "string"
        },
        "url": {
          "minLength": 1,
          "title": "Url",
          "type": "string"
        },
        "final_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Final Url"
        },
        "http_status": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Http Status"
        },
        "reachable": {
          "title": "Reachable",
          "type": "boolean"
        },
        "ad_group_refs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Ad Group Refs",
          "type": "array"
        },
        "h1": {
          "$ref": "#/$defs/DeviceText"
        },
        "message_match": {
          "$ref": "#/$defs/MessageMatch"
        },
        "proposed_h1": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProposedH1"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "proposed_h1_note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Proposed H1 Note"
        },
        "screenshots": {
          "$ref": "#/$defs/Screenshots"
        },
        "fold_px": {
          "$ref": "#/$defs/DevicePx"
        },
        "obscured_by_overlay": {
          "$ref": "#/$defs/DeviceFlag"
        },
        "evidence_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "audit_id",
        "url",
        "reachable",
        "ad_group_refs",
        "h1",
        "message_match",
        "screenshots",
        "fold_px",
        "obscured_by_overlay"
      ],
      "title": "LandingPageMatch",
      "type": "object"
    },
    "LintRef": {
      "additionalProperties": false,
      "description": "The asset's `LintResult`, by verdict. The full result is on the asset row.",
      "properties": {
        "verdict": {
          "enum": [
            "pass",
            "pass_with_warnings",
            "fail"
          ],
          "title": "Verdict",
          "type": "string"
        },
        "ruleset_version": {
          "minLength": 1,
          "title": "Ruleset Version",
          "type": "string"
        },
        "rule_ids": {
          "items": {
            "type": "string"
          },
          "title": "Rule Ids",
          "type": "array"
        }
      },
      "required": [
        "verdict",
        "ruleset_version"
      ],
      "title": "LintRef",
      "type": "object"
    },
    "MatchScore": {
      "additionalProperties": false,
      "description": "One ad group on one device: the H1 against that ad group's final A headlines.",
      "properties": {
        "campaign_ref": {
          "minLength": 1,
          "title": "Campaign Ref",
          "type": "string"
        },
        "ad_group_ref": {
          "minLength": 1,
          "title": "Ad Group Ref",
          "type": "string"
        },
        "device": {
          "enum": [
            "mobile",
            "desktop"
          ],
          "title": "Device",
          "type": "string"
        },
        "score": {
          "maximum": 1,
          "minimum": 0,
          "title": "Score",
          "type": "number"
        },
        "best_headline": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Best Headline"
        }
      },
      "required": [
        "campaign_ref",
        "ad_group_ref",
        "device",
        "score"
      ],
      "title": "MatchScore",
      "type": "object"
    },
    "MessageMatch": {
      "additionalProperties": false,
      "description": "The page's score is its weakest ad group on its weakest device.\n\nEvery ad group pointing here serves its ad on both devices, so a page that\nechoes one ad group on desktop and not another on mobile has failed that\nvisitor. `unavailable`: the page never rendered on either device.",
      "properties": {
        "score": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Score"
        },
        "metric": {
          "const": "match.token_trigram_v1",
          "default": "match.token_trigram_v1",
          "title": "Metric",
          "type": "string"
        },
        "threshold": {
          "maximum": 1,
          "minimum": 0,
          "title": "Threshold",
          "type": "number"
        },
        "verdict": {
          "enum": [
            "pass",
            "fail",
            "unavailable"
          ],
          "title": "Verdict",
          "type": "string"
        },
        "scores": {
          "items": {
            "$ref": "#/$defs/MatchScore"
          },
          "title": "Scores",
          "type": "array"
        },
        "evidence_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "threshold",
        "verdict"
      ],
      "title": "MessageMatch",
      "type": "object"
    },
    "ProposedH1": {
      "additionalProperties": false,
      "description": "A replacement H1, written by COPYWRITE, linted at the pin, scored by code.",
      "properties": {
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "score": {
          "maximum": 1,
          "minimum": 0,
          "title": "Score",
          "type": "number"
        },
        "lint": {
          "$ref": "#/$defs/LintRef"
        }
      },
      "required": [
        "text",
        "score",
        "lint"
      ],
      "title": "ProposedH1",
      "type": "object"
    },
    "Screenshots": {
      "additionalProperties": false,
      "description": "`StorageBackend` keys of the full-page PNGs; None where the page never answered.",
      "properties": {
        "mobile": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mobile"
        },
        "desktop": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Desktop"
        }
      },
      "title": "Screenshots",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "pages": {
      "items": {
        "$ref": "#/$defs/LandingPageMatch"
      },
      "title": "Pages",
      "type": "array"
    }
  },
  "title": "LandingMessageMatchOutput",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
