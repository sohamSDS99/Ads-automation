{
  "description": "The accepted research run, as the Stage 02 landing page needs it.",
  "properties": {
    "acceptance_id": {
      "format": "uuid",
      "title": "Acceptance Id",
      "type": "string"
    },
    "research_run_id": {
      "format": "uuid",
      "title": "Research Run Id",
      "type": "string"
    },
    "research_report_id": {
      "format": "uuid",
      "title": "Research Report Id",
      "type": "string"
    },
    "research_schema_version": {
      "title": "Research Schema Version",
      "type": "string"
    },
    "accepted_by": {
      "format": "uuid",
      "title": "Accepted By",
      "type": "string"
    },
    "accepted_by_name": {
      "title": "Accepted By Name",
      "type": "string"
    },
    "accepted_at": {
      "format": "date-time",
      "title": "Accepted At",
      "type": "string"
    },
    "note": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Note"
    },
    "override_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Override Reason"
    },
    "launch_readiness": {
      "enum": [
        "go",
        "go_with_fixes",
        "no_go"
      ],
      "title": "Launch Readiness",
      "type": "string"
    },
    "degraded_sources": {
      "items": {
        "type": "string"
      },
      "title": "Degraded Sources",
      "type": "array"
    },
    "age_days": {
      "title": "Age Days",
      "type": "integer"
    }
  },
  "required": [
    "acceptance_id",
    "research_run_id",
    "research_report_id",
    "research_schema_version",
    "accepted_by",
    "accepted_by_name",
    "accepted_at",
    "launch_readiness",
    "age_days"
  ],
  "title": "AcceptedSource",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
