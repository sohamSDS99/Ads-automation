        "from_price",
        "percent_off",
        "amount_off",
        "countdown",
        "free_trial",
        "price_match"
      ],
      "title": "Construction",
      "type": "string"
    },
    "field": {
      "minLength": 1,
      "title": "Field",
      "type": "string"
    },
    "source": {
