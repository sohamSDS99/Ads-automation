{
  "$defs": {
    "UserRole": {
      "enum": [
        "admin",
        "operator",
        "approver",
        "viewer"
      ],
      "title": "UserRole",
      "type": "string"
    }
  },
  "description": "What the public invite page renders before anyone types a password.\n\nCarries the workspace and role so the page can say what is being accepted,\nand nothing that would help enumerate the member list.",
  "properties": {
    "state": {
      "title": "State",
      "type": "string"
    },
    "email": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Email"
    },
    "role": {
      "anyOf": [
        {
          "$ref": "#/$defs/UserRole"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "workspace_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Workspace Name"
    },
    "expires_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expires At"
    }
  },
  "required": [
    "state"
  ],
  "title": "InvitePreviewResponse",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
