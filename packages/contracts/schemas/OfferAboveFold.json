{
  "$defs": {
    "Box": {
      "additionalProperties": false,
      "description": "A DOM box in page coordinates at scroll 0: `y` is distance from the top.",
      "properties": {
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        },
        "width": {
          "title": "Width",
          "type": "number"
        },
        "height": {
          "title": "Height",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "title": "Box",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "\u00a711 4.5.2: the offer is a normalised exact phrase in a text node whose\nbox top is above the fold \u2014 judged on each device separately.",
  "properties": {
    "phrase": {
      "minLength": 1,
      "title": "Phrase",
      "type": "string"
    },
    "found": {
      "title": "Found",
      "type": "boolean"
    },
    "bbox": {
      "anyOf": [
        {
          "$ref": "#/$defs/Box"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "device": {
      "enum": [
        "mobile",
        "desktop"
      ],
      "title": "Device",
      "type": "string"
    }
  },
  "required": [
    "phrase",
    "found",
    "device"
  ],
  "title": "OfferAboveFold",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
