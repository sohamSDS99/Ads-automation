{
  "additionalProperties": false,
  "description": "One rule, one target, one reason. Never a bare \"violation\".\n\n`authority_ref` duplicates `Rule.authority.reference` onto the finding on\npurpose: findings travel to a writer's screen and to Stage 04's logs\nwithout the ruleset attached, and \"who said so\" has to survive that trip.",
  "properties": {
    "target_ref": {
      "title": "Target Ref",
      "type": "string"
    },
    "rule_id": {
      "minLength": 1,
      "title": "Rule Id",
      "type": "string"
    },
    "severity": {
      "enum": [
        "blocking",
        "warning",
        "advisory"
      ],
      "title": "Severity",
      "type": "string"
    },
    "span": {
      "anyOf": [
        {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "integer"
            },
            {
              "type": "integer"
            }
          ],
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Span"
    },
    "message": {
      "minLength": 1,
      "title": "Message",
      "type": "string"
    },
    "fix_hint": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Fix Hint"
    },
    "authority_ref": {
      "minLength": 1,
      "title": "Authority Ref",
      "type": "string"
    },
    "claim_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Claim Id"
    },
    "indeterminate": {
      "default": false,
      "title": "Indeterminate",
      "type": "boolean"
    }
  },
  "required": [
    "target_ref",
    "rule_id",
    "severity",
    "message",
    "authority_ref"
  ],
  "title": "LintFinding",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
