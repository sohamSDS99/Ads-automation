{
  "description": "What a successful freeze returns.",
  "properties": {
    "plan_id": {
      "format": "uuid",
      "title": "Plan Id",
      "type": "string"
    },
    "plan_run_id": {
      "format": "uuid",
      "title": "Plan Run Id",
      "type": "string"
    },
    "project_id": {
      "format": "uuid",
      "title": "Project Id",
      "type": "string"
    },
    "version": {
      "title": "Version",
      "type": "integer"
    },
    "status": {
      "title": "Status",
      "type": "string"
    },
    "frozen_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Frozen At"
    },
    "frozen_by": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Frozen By"
    },
    "frozen_approval_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Frozen Approval Ids",
      "type": "array"
    },
    "superseded": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Superseded",
      "type": "array"
    },
    "already_frozen": {
      "default": false,
      "title": "Already Frozen",
      "type": "boolean"
    }
  },
  "required": [
    "plan_id",
    "plan_run_id",
    "project_id",
    "version",
    "status"
  ],
  "title": "FrozenPlan",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
