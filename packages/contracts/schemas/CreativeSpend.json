{
  "$defs": {
    "SpendMeter": {
      "description": "One cap as the Creative Console draws it: spent and reserved, two segments.",
      "properties": {
        "spent_usd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Spent Usd"
        },
        "reserved_usd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "description": "Held for media jobs submitted but not yet reconciled to `usage.cost` (law 43).",
          "title": "Reserved Usd"
        },
        "cap_usd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Cap Usd"
        }
      },
      "required": [
        "spent_usd",
        "reserved_usd",
        "cap_usd"
      ],
      "title": "SpendMeter",
      "type": "object"
    }
  },
  "description": "Stage 04 law 43's two caps (PRD \u00a715.4 C): `max_creative_cost_usd` over text\nand media, `max_media_cost_usd` over media alone.",
  "properties": {
    "total": {
      "$ref": "#/$defs/SpendMeter"
    },
    "media": {
      "$ref": "#/$defs/SpendMeter"
    }
  },
  "required": [
    "total",
    "media"
  ],
  "title": "CreativeSpend",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
