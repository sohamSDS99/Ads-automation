{
  "$defs": {
    "TaskClass": {
      "description": "What a node asks of a model. The only thing a node declares.",
      "enum": [
        "extract",
        "classify",
        "synthesize",
        "critique",
        "copywrite",
        "vision",
        "image_gen",
        "video_gen"
      ],
      "title": "TaskClass",
      "type": "string"
    }
  },
  "description": "What one task class is for, what it defaults to, and what it consumes.",
  "properties": {
    "task_class": {
      "$ref": "#/$defs/TaskClass"
    },
    "label": {
      "title": "Label",
      "type": "string"
    },
    "purpose": {
      "title": "Purpose",
      "type": "string"
    },
    "default_model": {
      "description": "The seed model, used when nothing is chosen",
      "title": "Default Model",
      "type": "string"
    },
    "fallbacks": {
      "items": {
        "type": "string"
      },
      "title": "Fallbacks",
      "type": "array"
    },
    "calls_per_run": {
      "title": "Calls Per Run",
      "type": "integer"
    },
    "token_in_per_run": {
      "title": "Token In Per Run",
      "type": "integer"
    },
    "token_out_per_run": {
      "title": "Token Out Per Run",
      "type": "integer"
    },
    "usage_source": {
      "description": "`measured` from completed runs, or `assumed` until there are enough",
      "title": "Usage Source",
      "type": "string"
    }
  },
  "required": [
    "task_class",
    "label",
    "purpose",
    "default_model",
    "fallbacks",
    "calls_per_run",
    "token_in_per_run",
    "token_out_per_run",
    "usage_source"
  ],
  "title": "TaskClassRouting",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
