{
  "$defs": {
    "Permission": {
      "description": "What a caller is allowed to do. One per PRD \u00a74.1 row group.",
      "enum": [
        "read",
        "project_write",
        "run_execute",
        "credential_write",
        "settings_write",
        "approval_decide",
        "user_manage",
        "audit_read",
        "plan_execute",
        "plan_freeze",
        "platform_admin"
      ],
      "title": "Permission",
      "type": "string"
    },
    "UserRole": {
      "enum": [
        "admin",
        "operator",
        "approver",
        "viewer"
      ],
      "title": "UserRole",
      "type": "string"
    },
    "WorkspaceMembershipSummary": {
      "description": "One entry in the workspace switcher.",
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/UserRole"
        },
        "is_member": {
          "title": "Is Member",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "name",
        "role",
        "is_member"
      ],
      "title": "WorkspaceMembershipSummary",
      "type": "object"
    }
  },
  "description": "The signed-in caller, the workspace they are in, and the ones they may switch to.\n\n`permissions` is advisory for the client. The server checks it again on\nevery route; hiding a button is cosmetic (PRD \u00a718 law 6).",
  "properties": {
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "email": {
      "title": "Email",
      "type": "string"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "role": {
      "$ref": "#/$defs/UserRole"
    },
    "permissions": {
      "items": {
        "$ref": "#/$defs/Permission"
      },
      "title": "Permissions",
      "type": "array"
    },
    "workspace_id": {
      "format": "uuid",
      "title": "Workspace Id",
      "type": "string"
    },
    "workspace_name": {
      "title": "Workspace Name",
      "type": "string"
    },
    "is_superadmin": {
      "default": false,
      "title": "Is Superadmin",
      "type": "boolean"
    },
    "via_superadmin": {
      "default": false,
      "title": "Via Superadmin",
      "type": "boolean"
    },
    "workspaces": {
      "items": {
        "$ref": "#/$defs/WorkspaceMembershipSummary"
      },
      "title": "Workspaces",
      "type": "array"
    }
  },
  "required": [
    "id",
    "email",
    "name",
    "role",
    "permissions",
    "workspace_id",
    "workspace_name"
  ],
  "title": "MeResponse",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
