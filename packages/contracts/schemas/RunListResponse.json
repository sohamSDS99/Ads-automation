{
  "$defs": {
    "RunMode": {
      "enum": [
        "full",
        "partial"
      ],
      "title": "RunMode",
      "type": "string"
    },
    "RunStatus": {
      "enum": [
        "queued",
        "running",
        "awaiting_approval",
        "succeeded",
        "failed",
        "cancelled"
      ],
      "title": "RunStatus",
      "type": "string"
    },
    "RunSummary": {
      "description": "A run as a list row: what happened, who asked, what it cost.",
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "project_id": {
          "format": "uuid",
          "title": "Project Id",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/RunStatus"
        },
        "mode": {
          "$ref": "#/$defs/RunMode"
        },
        "trigger": {
          "$ref": "#/$defs/RunTrigger"
        },
        "triggered_by": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Triggered By"
        },
        "triggered_by_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Null for a scheduled run, which has no actor",
          "title": "Triggered By Name"
        },
        "started_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Started At"
        },
        "finished_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finished At"
        },
        "cost_usd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "default": "0",
          "title": "Cost Usd"
        },
        "token_in": {
          "default": 0,
          "title": "Token In",
          "type": "integer"
        },
        "token_out": {
          "default": 0,
          "title": "Token Out",
          "type": "integer"
        },
        "error": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        }
      },
      "required": [
        "id",
        "project_id",
        "status",
        "mode",
        "trigger"
      ],
      "title": "RunSummary",
      "type": "object"
    },
    "RunTrigger": {
      "enum": [
        "manual",
        "schedule"
      ],
      "title": "RunTrigger",
      "type": "string"
    }
  },
  "properties": {
    "runs": {
      "items": {
        "$ref": "#/$defs/RunSummary"
      },
      "title": "Runs",
      "type": "array"
    }
  },
  "required": [
    "runs"
  ],
  "title": "RunListResponse",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
