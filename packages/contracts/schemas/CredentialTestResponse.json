{
  "$defs": {
    "CredentialKind": {
      "enum": [
        "openrouter",
        "google_ads",
        "dataforseo",
        "brightdata",
        "smtp"
      ],
      "title": "CredentialKind",
      "type": "string"
    }
  },
  "description": "The outcome of the cheapest call that proves a credential works.",
  "properties": {
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/CredentialKind"
    },
    "ok": {
      "title": "Ok",
      "type": "boolean"
    },
    "detail": {
      "description": "The sentence to show the person who pressed Test",
      "title": "Detail",
      "type": "string"
    },
    "meta": {
      "additionalProperties": true,
      "description": "Non-secret hints, e.g. account name or credit remaining",
      "title": "Meta",
      "type": "object"
    },
    "tested_at": {
      "format": "date-time",
      "title": "Tested At",
      "type": "string"
    }
  },
  "required": [
    "id",
    "kind",
    "ok",
    "detail",
    "tested_at"
  ],
  "title": "CredentialTestResponse",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
