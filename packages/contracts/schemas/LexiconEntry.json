{
  "additionalProperties": true,
  "description": "One term we always use, or never do. Compiles to a matcher or it is not here.",
  "properties": {
    "term": {
      "minLength": 1,
      "title": "Term",
      "type": "string"
    },
    "surface_forms": {
      "items": {
        "type": "string"
      },
      "title": "Surface Forms",
      "type": "array"
    },
    "severity": {
      "default": "warning",
      "title": "Severity",
      "type": "string"
    },
    "locale": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Locale"
    },
    "context": {
      "default": "",
      "title": "Context",
      "type": "string"
    },
    "reason": {
      "default": "",
      "title": "Reason",
      "type": "string"
    },
    "suggested_replacement": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Suggested Replacement"
    }
  },
  "required": [
    "term"
  ],
  "title": "LexiconEntry",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
