{
  "$defs": {
    "AllowlistEntry": {
      "additionalProperties": false,
      "properties": {
        "model_id": {
          "minLength": 1,
          "title": "Model Id",
          "type": "string"
        },
        "provider_tag": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Tag"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        }
      },
      "required": [
        "model_id"
      ],
      "title": "AllowlistEntry",
      "type": "object"
    },
    "MediaAllowlist": {
      "additionalProperties": false,
      "properties": {
        "image": {
          "items": {
            "$ref": "#/$defs/AllowlistEntry"
          },
          "title": "Image",
          "type": "array"
        },
        "video": {
          "items": {
            "$ref": "#/$defs/AllowlistEntry"
          },
          "title": "Video",
          "type": "array"
        }
      },
      "title": "MediaAllowlist",
      "type": "object"
    },
    "MediaDefaults": {
      "additionalProperties": false,
      "description": "Workspace default params per modality, applied under a project's own.",
      "properties": {
        "image": {
          "additionalProperties": true,
          "title": "Image",
          "type": "object"
        },
        "video": {
          "additionalProperties": true,
          "title": "Video",
          "type": "object"
        }
      },
      "title": "MediaDefaults",
      "type": "object"
    }
  },
  "description": "`GET /settings/media`. Nothing is allowlisted by default (PRD \u00a79.2).",
  "properties": {
    "media_allowlist": {
      "$ref": "#/$defs/MediaAllowlist"
    },
    "media_defaults": {
      "$ref": "#/$defs/MediaDefaults"
    }
  },
  "title": "MediaSettings",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
