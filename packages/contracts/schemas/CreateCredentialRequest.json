{
  "$defs": {
    "CredentialKind": {
      "enum": [
        "openrouter",
        "google_ads",
        "dataforseo",
        "smtp"
      ],
      "title": "CredentialKind",
      "type": "string"
    },
    "CredentialScope": {
      "enum": [
        "workspace",
        "project",
        "user"
      ],
      "title": "CredentialScope",
      "type": "string"
    }
  },
  "description": "Store a secret.\n\nPRD \u00a714 writes this body as `{scope, kind, secret, project_id?}`. It takes\n`values` instead: `google_ads` needs five values and `dataforseo` two, and\none opaque `secret` string would make every client invent the same encoding\nindependently. A single-field kind is `{\"api_key\": \"...\"}` and seals to the\nbare value, so what reaches the vault is unchanged.",
  "properties": {
    "kind": {
      "$ref": "#/$defs/CredentialKind"
    },
    "scope": {
      "$ref": "#/$defs/CredentialScope",
      "default": "workspace"
    },
    "project_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Project Id"
    },
    "values": {
      "additionalProperties": {
        "maxLength": 8192,
        "minLength": 1,
        "type": "string"
      },
      "minProperties": 1,
      "title": "Values",
      "type": "object"
    }
  },
  "required": [
    "kind",
    "values"
  ],
  "title": "CreateCredentialRequest",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
