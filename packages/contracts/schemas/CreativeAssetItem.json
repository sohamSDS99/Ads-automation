{
  "$defs": {
    "CreativeAssetKind": {
      "enum": [
        "headline",
        "long_headline",
        "description",
        "path",
        "sitelink",
        "callout",
        "structured_snippet",
        "promotion",
        "price",
        "lead_form",
        "business_name",
        "video_script",
        "image",
        "video",
        "logo"
      ],
      "title": "CreativeAssetKind",
      "type": "string"
    },
    "CreativeAssetStatus": {
      "enum": [
        "draft",
        "linted",
        "reserve",
        "awaiting_review",
        "approved",
        "rejected",
        "dropped",
        "awaiting_exception",
        "released"
      ],
      "title": "CreativeAssetStatus",
      "type": "string"
    },
    "CreativeAssetVariant": {
      "enum": [
        "A",
        "B"
      ],
      "title": "CreativeAssetVariant",
      "type": "string"
    }
  },
  "description": "One `CreativeAsset`, with the lint verdict it was stored with (law 33).",
  "properties": {
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "node_id": {
      "title": "Node Id",
      "type": "string"
    },
    "campaign_ref": {
      "title": "Campaign Ref",
      "type": "string"
    },
    "ad_group_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Ad Group Ref"
    },
    "ad_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Ad Ref"
    },
    "kind": {
      "$ref": "#/$defs/CreativeAssetKind"
    },
    "surface": {
      "title": "Surface",
      "type": "string"
    },
    "variant": {
      "anyOf": [
        {
          "$ref": "#/$defs/CreativeAssetVariant"
        },
        {
          "type": "null"
        }
      ]
    },
    "category": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Category"
    },
    "text": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Text"
    },
    "fields": {
      "additionalProperties": true,
      "title": "Fields",
      "type": "object"
    },
    "claim_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Claim Ids",
      "type": "array"
    },
    "pin_position": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Pin Position"
    },
    "generated_by_ai": {
      "title": "Generated By Ai",
      "type": "boolean"
    },
    "status": {
      "$ref": "#/$defs/CreativeAssetStatus"
    },
    "lint_verdict": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "`pass`, `pass_with_warnings` or `fail`, as the linter returned it at creation.",
      "title": "Lint Verdict"
    },
    "ruleset_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Ruleset Version"
    },
    "lineage": {
      "additionalProperties": true,
      "title": "Lineage",
      "type": "object"
    },
    "content_hash": {
      "title": "Content Hash",
      "type": "string"
    },
    "frozen_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Frozen At"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    }
  },
  "required": [
    "id",
    "node_id",
    "campaign_ref",
    "ad_group_ref",
    "ad_ref",
    "kind",
    "surface",
    "variant",
    "category",
    "text",
    "fields",
    "claim_ids",
    "pin_position",
    "generated_by_ai",
    "status",
    "lint_verdict",
    "ruleset_version",
    "lineage",
    "content_hash",
    "frozen_at",
    "created_at"
  ],
  "title": "CreativeAssetItem",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
