{
  "$defs": {
    "GuidelineBindings": {
      "additionalProperties": false,
      "description": "Which Stage 01 and Stage 02 artifacts this run was pointed at.\n\nResolved once at run start and hashed into `Run.input_hash`. A binding that\ndoes not resolve is *dropped* rather than fatal \u2014 Stage 03 does not need\nit, and a stage that starts cold must not acquire a hard dependency by way\nof an optional one (\u00a74.5 rule 4).",
      "properties": {
        "research_run_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Research Run Id"
        },
        "acceptance_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Acceptance Id"
        },
        "research_schema_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Research Schema Version"
        },
        "plan_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Plan Id"
        },
        "plan_version": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Plan Version"
        },
        "plan_schema_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Plan Schema Version"
        }
      },
      "title": "GuidelineBindings",
      "type": "object"
    },
    "GuidelineMode": {
      "description": "Which optional bindings resolved at run start (PRD \u00a74.2).\n\nDerived from what actually resolved, never taken from the client. The four\nvalues are not a quality ranking \u2014 `standalone` is a first-class, tested\npath (law 21) \u2014 they are a record of what the rulebook was built from.",
      "enum": [
        "standalone",
        "research_linked",
        "plan_linked",
        "fully_linked"
      ],
      "title": "GuidelineMode",
      "type": "string"
    },
    "GuidelineStatus": {
      "description": "PRD \u00a712.4. `succeeded` on the run never means `published`.",
      "enum": [
        "draft",
        "blocked",
        "ready_to_publish",
        "published",
        "superseded"
      ],
      "title": "GuidelineStatus",
      "type": "string"
    }
  },
  "description": "One guideline, with the payload the Rulebook Viewer renders.",
  "properties": {
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "version_major": {
      "title": "Version Major",
      "type": "integer"
    },
    "version_minor": {
      "title": "Version Minor",
      "type": "integer"
    },
    "status": {
      "$ref": "#/$defs/GuidelineStatus"
    },
    "mode": {
      "$ref": "#/$defs/GuidelineMode"
    },
    "guideline_run_id": {
      "format": "uuid",
      "title": "Guideline Run Id",
      "type": "string"
    },
    "ruleset_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ruleset Id"
    },
    "unbound_inputs": {
      "items": {
        "type": "string"
      },
      "title": "Unbound Inputs",
      "type": "array"
    },
    "signature_stale": {
      "default": false,
      "title": "Signature Stale",
      "type": "boolean"
    },
    "binding_superseded": {
      "default": false,
      "title": "Binding Superseded",
      "type": "boolean"
    },
    "published_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Published At"
    },
    "published_by": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Published By"
    },
    "published_by_name": {
      "default": "",
      "title": "Published By Name",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "rule_count": {
      "default": 0,
      "title": "Rule Count",
      "type": "integer"
    },
    "claim_count": {
      "default": 0,
      "title": "Claim Count",
      "type": "integer"
    },
    "project_id": {
      "format": "uuid",
      "title": "Project Id",
      "type": "string"
    },
    "schema_version": {
      "title": "Schema Version",
      "type": "string"
    },
    "bindings": {
      "$ref": "#/$defs/GuidelineBindings"
    },
    "payload": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Payload"
    },
    "markdown": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Markdown"
    }
  },
  "required": [
    "id",
    "version_major",
    "version_minor",
    "status",
    "mode",
    "guideline_run_id",
    "created_at",
    "project_id",
    "schema_version",
    "bindings"
  ],
  "title": "GuidelineDetail",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
