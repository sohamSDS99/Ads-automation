{
  "$defs": {
    "CredentialKind": {
      "enum": [
        "openrouter",
        "google_ads",
        "dataforseo",
        "smtp"
      ],
      "title": "CredentialKind",
      "type": "string"
    },
    "CredentialScope": {
      "enum": [
        "workspace",
        "project",
        "user"
      ],
      "title": "CredentialScope",
      "type": "string"
    }
  },
  "description": "A stored credential, as the vault is allowed to describe it.\n\n`meta` holds only what was marked non-secret when the credential was\nwritten \u2014 an account id, a login, the last four characters of a key.",
  "properties": {
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/CredentialKind"
    },
    "scope": {
      "$ref": "#/$defs/CredentialScope"
    },
    "project_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Project Id"
    },
    "user_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "User Id"
    },
    "meta": {
      "additionalProperties": true,
      "title": "Meta",
      "type": "object"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "created_by": {
      "format": "uuid",
      "title": "Created By",
      "type": "string"
    },
    "created_by_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Created By Name"
    },
    "last_tested_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last Tested At"
    },
    "last_test_ok": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last Test Ok"
    }
  },
  "required": [
    "id",
    "kind",
    "scope",
    "meta",
    "created_at",
    "created_by"
  ],
  "title": "CredentialSummary",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
