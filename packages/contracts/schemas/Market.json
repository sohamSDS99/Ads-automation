{
  "description": "One country the campaign will run in. PRD \u00a76: `[{country, language, currency}]`.",
  "properties": {
    "country": {
      "description": "ISO 3166-1 alpha-2, e.g. NO",
      "maxLength": 2,
      "minLength": 2,
      "title": "Country",
      "type": "string"
    },
    "language": {
      "description": "ISO 639-1, e.g. nb",
      "maxLength": 5,
      "minLength": 2,
      "title": "Language",
      "type": "string"
    },
    "currency": {
      "description": "ISO 4217, e.g. NOK",
      "maxLength": 3,
      "minLength": 3,
      "title": "Currency",
      "type": "string"
    }
  },
  "required": [
    "country",
    "language",
    "currency"
  ],
  "title": "Market",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
