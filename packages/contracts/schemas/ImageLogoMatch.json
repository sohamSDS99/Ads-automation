{
  "description": "One registered logo found in the submitted image.",
  "properties": {
    "asset_id": {
      "format": "uuid",
      "title": "Asset Id",
      "type": "string"
    },
    "label": {
      "title": "Label",
      "type": "string"
    },
    "score": {
      "title": "Score",
      "type": "number"
    },
    "bbox": {
      "anyOf": [
        {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "integer"
            },
            {
              "type": "integer"
            },
            {
              "type": "integer"
            },
            {
              "type": "integer"
            }
          ],
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Bbox"
    },
    "phash_distance": {
      "title": "Phash Distance",
      "type": "integer"
    },
    "method": {
      "enum": [
        "orb",
        "phash"
      ],
      "title": "Method",
      "type": "string"
    }
  },
  "required": [
    "asset_id",
    "label",
    "score",
    "phash_distance",
    "method"
  ],
  "title": "ImageLogoMatch",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
