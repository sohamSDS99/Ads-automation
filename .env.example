# ---------------------------------------------------------------------------
# ads-research-agent — local development environment
# Copy to .env and edit. On Railway these same names are set as reference
# expressions instead of literals — see railway/variables.md.
# ---------------------------------------------------------------------------

# --- core ------------------------------------------------------------------
# PORT is injected by Railway. Locally it is set per-service in docker-compose.
DATABASE_URL=postgresql://agent:agent@postgres:5432/agent
REDIS_URL=redis://redis:6379/0

# 32 bytes, base64-encoded. Generate with:
#   python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
# THIS DEFAULT IS FOR LOCAL DEVELOPMENT ONLY. Never reuse it in production.
APP_ENCRYPTION_KEY=ZGV2LW9ubHkta2V5LWRvLW5vdC11c2UtaW4tcHJvZCE=

# --- sessions --------------------------------------------------------------
SESSION_COOKIE_NAME=ara_session
SESSION_TTL_DAYS=30
# false locally (plain http), true on Railway (TLS terminated on `web`)
COOKIE_SECURE=false

# --- public URLs -----------------------------------------------------------
# Where a browser reaches this installation. Invite links are built from it, so
# leaving the default in production produces links that resolve to localhost.
APP_BASE_URL=http://localhost:3000

# --- bootstrap admin -------------------------------------------------------
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# At least 12 characters, and not on the common-password list. The API refuses
# to bootstrap with a weak one rather than create an admin nobody can trust.
BOOTSTRAP_ADMIN_PASSWORD=change-me-at-least-12-chars

# --- llm -------------------------------------------------------------------
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- the source keys ---------------------------------------------------------
# This is the only place any secret lives. The Connections screen switches a
# source on and off for a workspace; it never asks anyone for a key and has
# nowhere to put one. So a source that is not filled in here cannot be
# connected, and the screen names the exact variables it is waiting for.
#
# `docker-compose.yml` is an allow-list: a variable absent from its `x-api-env`
# block never reaches the container however carefully it is set here.
# `test_deployment_config.py` asserts this file, that block and the source
# catalogue all agree.
#
# Restart the API after changing any of these — they are read once at startup.

# The model surface. Every node is a call through it, so a run cannot start
# until OpenRouter is both set here and connected.
OPENROUTER_API_KEY=

# Keyword volume, cost per click, competition, seasonality.
DATAFORSEO_API_KEY=

# The Webshare crawl proxy. Optional, unlike the two above: with no key every
# crawl goes out directly and nothing degrades.
WEBSHARE_API_KEY=

# Google Ads is five values, and only these three are yours to set.
#
#   GOOGLE_ADS_DEVELOPER_TOKEN   issued once, in the manager account's API Center
#   GOOGLE_ADS_CLIENT_ID         ) a Google Cloud OAuth client, type **Web
#   GOOGLE_ADS_CLIENT_SECRET     ) application** (not Desktop — see below)
#
# The other two — a refresh token and the customer id — come from a person
# pressing **Connect with Google** under Settings → Connections. Nobody can put
# those in an environment on somebody else's behalf, and a developer token is
# issued once to one manager account, so requiring one per colleague would mean
# most of them never connect. The grant is sealed onto that workspace's
# connection row; every workspace on the installation signs in separately.
#
# Two things must be true in the Cloud console for the button to work:
#
#   1. The **Authorised redirect URI** must be, exactly,
#        <APP_BASE_URL>/api/v1/connections/google/callback
#      Google compares it byte for byte, and this is the *web app's* address,
#      not the API's — `api` has no ingress, so every browser request arrives
#      through the web app's rewrite. Register one per environment:
#        http://localhost:3000/api/v1/connections/google/callback
#        https://<your-app>.up.railway.app/api/v1/connections/google/callback
#      A URI that is not registered fails as `Error 400: redirect_uri_mismatch`
#      on Google's own page, before the person ever sees a consent screen.
#
#   2. The consent screen's publishing status must be **In production**. While
#      it is in *Testing*, Google expires every refresh token after **seven
#      days** — the button works, and then every workspace is silently signed
#      out a week later.
#
# The scopes asked for are Google Ads, Analytics (read-only), Search Console
# (read-only), and `openid email` so the card can say which account is
# connected. Only Google Ads is spent today; the other two are asked for now
# because widening a scope later costs every person who already connected a
# second trip through the consent screen.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
#
# Set by `make google-ads-oauth` for a deployment that would rather mint one
# grant on the command line than have people sign in. A workspace that signs in
# through the interface overrides both, so these are a fallback and not the
# path to reach for.
# GOOGLE_ADS_REFRESH_TOKEN=
# GOOGLE_ADS_CUSTOMER_ID=
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# --- webshare (the crawl proxy) --------------------------------------------
# Shape only; the account itself is WEBSHARE_API_KEY above. Every one has a
# working default in `config.Settings` — override only to crawl from a
# different country.
# WEBSHARE_COUNTRY=us
# WEBSHARE_PROXY_HOST=p.webshare.io
# WEBSHARE_PROXY_PORT=80

# --- storage ---------------------------------------------------------------
STORAGE_BACKEND=local
STORAGE_DIR=/data
WORKER_INTERNAL_URL=http://worker:8081
# HMAC secret for short-lived file download tokens. Same generation as above.
FILE_TOKEN_SECRET=ZGV2LW9ubHktZmlsZS10b2tlbi1zZWNyZXQtMzJieXQ=

# --- budget ----------------------------------------------------------------
MAX_RUN_COST_USD=15.00

# --- smtp (all optional; invites fall back to copyable links) --------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# --- web -------------------------------------------------------------------
# Server-side only. The browser never sees this and never calls the API
# directly — next.config.ts rewrites /api/v1/* to it. No public (browser-
# visible) env var carries an API address anywhere in this repo.
API_INTERNAL_URL=http://api:8000
