# ---------------------------------------------------------------------------
# ads-research-agent — local development environment
# Copy to .env and edit. On Railway these same names are set as reference
# expressions instead of literals — see railway/variables.md.
# ---------------------------------------------------------------------------

# --- core ------------------------------------------------------------------
# PORT is injected by Railway. Locally it is set per-service in docker-compose.
DATABASE_URL=postgresql://agent:agent@postgres:5432/agent
REDIS_URL=redis://redis:6379/0

# 32 bytes, base64-encoded. Generate with:
#   python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
# THIS DEFAULT IS FOR LOCAL DEVELOPMENT ONLY. Never reuse it in production.
APP_ENCRYPTION_KEY=ZGV2LW9ubHkta2V5LWRvLW5vdC11c2UtaW4tcHJvZCE=

# --- sessions --------------------------------------------------------------
SESSION_COOKIE_NAME=ara_session
SESSION_TTL_DAYS=30
# false locally (plain http), true on Railway (TLS terminated on `web`)
COOKIE_SECURE=false

# --- public URLs -----------------------------------------------------------
# Where a browser reaches this installation. Invite links are built from it, so
# leaving the default in production produces links that resolve to localhost.
APP_BASE_URL=http://localhost:3000

# --- bootstrap admin -------------------------------------------------------
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# At least 12 characters, and not on the common-password list. The API refuses
# to bootstrap with a weak one rather than create an admin nobody can trust.
BOOTSTRAP_ADMIN_PASSWORD=change-me-at-least-12-chars

# --- llm -------------------------------------------------------------------
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- the source keys this deployment supplies ------------------------------
# Read by the app itself. A workspace credential stored through the Sources
# screen overrides whatever is set here; with no such row, these are what a run
# uses, so a deployment can be configured from this file and never open the
# interface. `google_ads` is deliberately absent — its secret is a refresh token
# that consent mints, so there is nothing to paste.
OPENROUTER_API_KEY=
BRIGHTDATA_API_KEY=
DATAFORSEO_API_KEY=

# --- the Google OAuth client this deployment offers -------------------------
# Read by the API, not by a script: they are what "Continue with Google" on the
# Sources screen sends the account owner to. The client must be of type **Web
# application** in production, with this exact redirect URI registered:
#   <APP_BASE_URL>/api/v1/credentials/google-ads/callback
# A Desktop client also works while APP_BASE_URL is a localhost address, because
# Google treats that as a loopback redirect.
GOOGLE_ADS_OAUTH_CLIENT_ID=
GOOGLE_ADS_OAUTH_CLIENT_SECRET=

# Google Ads is five values, not one. The developer token is issued once, in the
# manager account's API Center; the OAuth three are minted by
# `make google-ads-oauth`, which also prints every customer id the consent
# reaches. The manager id is needed only when the account is reached through an
# MCC. Same rule as above: the app reads these from the vault, never from here.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# --- serp ------------------------------------------------------------------
# Shape, not secret. Every one has a working default in `config.Settings`;
# override only to point at a different default market.
# SERP_COUNTRY=us
# SERP_LANGUAGE=en
# SERP_MAX_KEYWORDS=25
# The zone the API key bills to is discovered from the key itself. Set this
# only if the account has more than one SERP zone and discovery picks wrong.
# SERP_ZONE=

# --- storage ---------------------------------------------------------------
STORAGE_BACKEND=local
STORAGE_DIR=/data
WORKER_INTERNAL_URL=http://worker:8081
# HMAC secret for short-lived file download tokens. Same generation as above.
FILE_TOKEN_SECRET=ZGV2LW9ubHktZmlsZS10b2tlbi1zZWNyZXQtMzJieXQ=

# --- budget ----------------------------------------------------------------
MAX_RUN_COST_USD=15.00

# --- smtp (all optional; invites fall back to copyable links) --------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# --- web -------------------------------------------------------------------
# Server-side only. The browser never sees this and never calls the API
# directly — next.config.ts rewrites /api/v1/* to it. No public (browser-
# visible) env var carries an API address anywhere in this repo.
API_INTERNAL_URL=http://api:8000
