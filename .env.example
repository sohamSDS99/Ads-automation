# ---------------------------------------------------------------------------
# ads-research-agent — local development environment
# Copy to .env and edit. On Railway these same names are set as reference
# expressions instead of literals — see railway/variables.md.
# ---------------------------------------------------------------------------

# --- core ------------------------------------------------------------------
# PORT is injected by Railway. Locally it is set per-service in docker-compose.
DATABASE_URL=postgresql://agent:agent@postgres:5432/agent
REDIS_URL=redis://redis:6379/0

# 32 bytes, base64-encoded. Generate with:
#   python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
# THIS DEFAULT IS FOR LOCAL DEVELOPMENT ONLY. Never reuse it in production.
APP_ENCRYPTION_KEY=ZGV2LW9ubHkta2V5LWRvLW5vdC11c2UtaW4tcHJvZCE=

# --- sessions --------------------------------------------------------------
SESSION_COOKIE_NAME=ara_session
# Cookie life. 400 days is Chrome's ceiling for any cookie.
SESSION_TTL_DAYS=400
# 0 = signing out is the only thing that ends a session. Set either to a
# positive number to put PRD §6.1.3's 12h/30d clocks back.
SESSION_IDLE_TIMEOUT_HOURS=0
SESSION_ABSOLUTE_LIFETIME_DAYS=0
# false locally (plain http), true on Railway (TLS terminated on `web`)
COOKIE_SECURE=false

# --- public URLs -----------------------------------------------------------
# Where a browser reaches this installation. Invite links are built from it, so
# leaving the default in production produces links that resolve to localhost.
APP_BASE_URL=http://localhost:3000

# --- bootstrap admin -------------------------------------------------------
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# At least 12 characters, and not on the common-password list. The API refuses
# to bootstrap with a weak one rather than create an admin nobody can trust.
BOOTSTRAP_ADMIN_PASSWORD=change-me-at-least-12-chars

# --- llm -------------------------------------------------------------------
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- accounts the scripts seed, and the app does not read ------------------
# The OpenRouter key and the Bright Data SERP account are vault credentials,
# written through POST /credentials and encrypted with APP_ENCRYPTION_KEY. The
# application never reads them from the environment — these names exist so
# `scripts/verify-*.sh` can store them for you instead of you typing them into
# the setup wizard first.
OPENROUTER_API_KEY=
BRIGHTDATA_PROXY_USERNAME=
BRIGHTDATA_PROXY_PASSWORD=

# --- serp ------------------------------------------------------------------
# Shape, not secret. Every one has a working default in `config.Settings`;
# override only to point at a different proxy or a different default market.
# SERP_PROXY_HOST=brd.superproxy.io
# SERP_PROXY_PORT=33335
# SERP_COUNTRY=us
# SERP_LANGUAGE=en
# SERP_MAX_KEYWORDS=25
# The proxy signs google.com with its own CA, so verification is off until that
# CA is installed in the image. See `connectors/serp.py`.
# SERP_VERIFY_TLS=false

# --- storage ---------------------------------------------------------------
STORAGE_BACKEND=local
STORAGE_DIR=/data
WORKER_INTERNAL_URL=http://worker:8081
# HMAC secret for short-lived file download tokens. Same generation as above.
FILE_TOKEN_SECRET=ZGV2LW9ubHktZmlsZS10b2tlbi1zZWNyZXQtMzJieXQ=

# --- budget ----------------------------------------------------------------
MAX_RUN_COST_USD=15.00

# --- smtp (all optional; invites fall back to copyable links) --------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# --- web -------------------------------------------------------------------
# Server-side only. The browser never sees this and never calls the API
# directly — next.config.ts rewrites /api/v1/* to it. No public (browser-
# visible) env var carries an API address anywhere in this repo.
API_INTERNAL_URL=http://api:8000
